/*
 * graphter-sim: synthetic metagenomes + pangenome graphs from a target species
 */

manifest {
    name            = 'graphter-sim'
    description     = 'Generate synthetic metagenome assembly graphs, a pangenome graph and genomovar ground truth for a target species'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
    license         = 'Artistic-2.0'
}

params {
    // ---- Input -----------------------------------------------------------
    species               = ''            // e.g. "Escherichia coli" or "s__Escherichia coli"
    max_target_genomes    = 100           // genomes downloaded from the target species (random subset)
    n_background          = 50            // background genomes (one per random species)
    background_taxon      = 'd__Bacteria' // GTDB taxon from which background species are drawn
    // Use local genomes instead of downloading (directory or glob of FastA files)
    target_genomes        = ''
    background_genomes    = ''
    ncbi_api_key          = ''
    miga_get_args         = '--ignore-removed'

    // ---- Target genome partition ---------------------------------------
    // Values summing to <= 1 are fractions of the target genomes; otherwise
    // they are absolute numbers of genomes.
    split_mg_only         = 1/3           // genomes only in the metagenomes
    split_pg_only         = 1/3           // genomes only in the pangenome
    split_both            = 1/3           // genomes in both

    // ---- Metagenome design ---------------------------------------------
    n_metagenomes         = 3
    target_depth          = 50            // total depth of the target species per metagenome (X)
    target_per_metagenome = 0             // target genomes per metagenome (0: auto)
    target_abundance      = 'random'      // 'random' (log-normal) or 'even' split of target_depth
    target_abundance_sdlog = 1.0
    background_per_metagenome = 0         // background genomes per metagenome (0: half of them)
    background_depth_mean = 10            // mean depth of each background genome (X)
    background_depth_sdlog = 1.0          // log-normal dispersion of background depths
    seed                  = 42

    // ---- Read simulation -----------------------------------------------
    // One of: illumina, illumina+nanopore, illumina+pacbio
    // (metaSPAdes needs short reads; long reads are used for hybrid assembly)
    read_technology       = 'illumina'
    illumina_model        = 'novaseq'     // InSilicoSeq model: hiseq, novaseq, miseq, nextseq
    illumina_read_length  = 0             // 0: inferred from the model
    long_read_depth_scale = 1.0           // long-read depth relative to short-read depth
    badread_nanopore_args = '--error_model nanopore2023 --qscore_model nanopore2023'
    badread_pacbio_args   = '--error_model pacbio2021 --qscore_model pacbio2021 --identity 30,3'

    // ---- Assembly --------------------------------------------------------
    spades_args           = ''
    spades_ec_timeout     = '4.h'         // max time for read error correction (0: no limit)
    keep_spades_dir       = false         // keep metaSPAdes' working directory (debugging)

    // ---- Pangenome -------------------------------------------------------
    pangenome_tool        = 'pggb'        // 'pggb' or 'minigraph'
    pggb_args             = '-p 95 -s 5000'
    minigraph_args        = '-cxggs'

    // ---- Genomovars (MiGA derep_wf) ------------------------------------
    genomovar_ani         = 99.5
    derep_min_qual        = 'no'          // 'no' keeps every genome; MiGA default is 25
    derep_args            = '--only-ani'

    // ---- Output / resources ---------------------------------------------
    outdir                = 'results'
    publish_mode          = 'copy'
    miga_home             = ''            // directory with an initialized MiGA (.miga_rc)
    miga_container        = ''
    // Upper bounds for any single task; larger requests are capped to these
    max_cpus              = Runtime.runtime.availableProcessors()
    // Defaults to 95% of this host's RAM (set explicitly for -profile slurm)
    max_memory            = "${(java.lang.management.ManagementFactory.operatingSystemMXBean.totalMemorySize * 0.95 / 1048576).toLong()}.MB"
    max_time              = '240.h'
    // Suffix for timeline/report/trace files (top-level `def` is rejected by
    // the strict config parser, the default since Nextflow 26)
    trace_timestamp       = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

process {
    resourceLimits = [cpus: params.max_cpus as int, memory: params.max_memory as MemoryUnit, time: params.max_time as Duration]
    cpus   = 1
    memory = '4.GB'
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'terminate' }
    maxRetries = 2

    withLabel: miga_download {
        cpus = 1; memory = '4.GB'; maxRetries = 3
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
    }
    withLabel: miga_derep { cpus = 8;  memory = '32.GB' }
    withLabel: simulate   { cpus = 4;  memory = '8.GB' }
    withLabel: assembly   { cpus = 16; memory = { 64.GB * task.attempt } }
    withLabel: pangenome  { cpus = 16; memory = '32.GB' }
    withLabel: pansn      { cpus = 2;  memory = '2.GB' }
    withLabel: 'miga_download|miga_derep' {
        container = params.miga_container ?: null  // '' means: use local MiGA
    }
}

profiles {
    standard { process.executor = 'local' }
    conda {
        conda.enabled       = true
        conda.useMamba      = false
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
    }
    // Containers are built on the fly from the conda environments in envs/
    // with Wave (https://seqera.io/wave). MiGA is not built this way: install
    // it locally or set --miga_container.
    docker {
        docker.enabled  = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        wave.enabled    = true
        wave.strategy   = 'conda'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        wave.enabled           = true
        wave.strategy          = 'conda'
        wave.freeze            = true
    }
    slurm { process.executor = 'slurm' }
    test {
        params.max_target_genomes = 12
        params.n_background       = 6
        params.n_metagenomes      = 2
        params.target_depth       = 10
        process.cpus              = 2
        process.memory            = '4.GB'
        process {
            // Memory is ~2-4x the peak RSS seen on the E. coli test (seed 42).
            // Same keys as the base config, so these replace its values.
            withLabel: miga_derep { cpus = 4; memory = '4.GB' }  // peak 0.9 GB
            withLabel: simulate   { cpus = 4; memory = '2.GB' }  // peak 0.5 GB
            withLabel: assembly   { cpus = 4; memory = '8.GB' }  // peak 2.1 GB
            withLabel: pangenome  { cpus = 4; memory = '4.GB' }  // peak 1.6 GB
        }
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${params.trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${params.trace_timestamp}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${params.trace_timestamp}.txt" }
